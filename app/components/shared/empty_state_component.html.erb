<div class="bg-white mx-auto p-8 text-center">
  <div class="mb-6">
    <%= helpers.tabler_icon(icon, size: 100, class: "mx-auto text-gray-300") %>
  </div>
  <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= title %></h3>
  <p class="text-gray-600 mb-6">
    <%= description %>
  </p>
  <%= link_to path,
      data: data_turbo_frame,
      class: "inline-flex items-center justify-center gap-2 p-2 rounded-lg bg-primary hover:bg-hover text-sm text-white transition-colors" do %>
    <%= helpers.tabler_icon(icon_button, size: 15) %>
    <%= text %>
  <% end %>
</div>