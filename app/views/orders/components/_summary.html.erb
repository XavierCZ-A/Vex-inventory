<%= render(Shared::SummaryCardComponent.new(title: "Resumen de ordenes")) do |dashboard| %>
  <% dashboard.with_card(
    title: "Total de ordenes",
    value: @orders.count,
    icon: "clipboard-check"
  ) %>
  
  <% dashboard.with_card(
    title: "Gastos $",
    value: @orders.total_cost_all_orders,
    icon: "currency-dollar",
    formatter: :currency,
    color: "green"
  ) %>
  
  <% dashboard.with_card(
    title: "Pendientes",
    value: @orders.pending.count,
    icon: "clock",
    color: "yellow",
    formatter: :delimiter
  ) %>

<% end %>
