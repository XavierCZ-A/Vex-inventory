<tr id="<%= dom_id order %>" class="bg-white hover:bg-gray-200">
  <td class="px-6 py-4">
    <%= link_to order_path(order), class: "flex text-sm font-medium hover:underline transition duration-200 cursor-pointer" do %>
      <%= order.order_number %>
    <% end %>
  </td>
  <td class="px-6 py-4">
    <p class="text-sm font-medium text-gray-900">
      <%= order.order_date %>
    </p>
  </td>
  <td class="px-6 py-4">
    <%= form_with(url: update_status_order_path(order), method: :patch, local: false) do |form| %>
      <%= form.select :status, 
        Order.statuses.keys.map { |status| [status.humanize, status] }, 
        { selected: order.status }, 
        { onChange: 'this.form.requestSubmit()', class: "form-select status-select" }
      %>
    <% end %>
  </td>
</tr>
