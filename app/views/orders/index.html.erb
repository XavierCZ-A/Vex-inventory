<% content_for :title, "Orders" %>
<div class="w-full mx-auto p-3">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Orders</h1>
    <% if @orders.any? %>
      <%= link_to new_order_path, class: "principal-button" do %>
        <%= tabler_icon('truck-delivery', size: '20', class: "mr-2") %>
        Create order
      <% end %>
    <% end %>
  </div>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <div id="orders" class="overflow-hidden p-2 rounded-lg border border-gray-200 shadow">
    <% if @orders.any? %>
      <section class="relative overflow-x-auto">
        <table class="min-w-full bg-white">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order number</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render @orders %>
          </tbody>
        </table>
      </section>
    <% else %>
      <div class="bg-white mx-auto p-8 text-center">
        <div class="mb-6">
          <%= tabler_icon('truck-delivery', size: '100', class: "mx-auto text-gray-300") %>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">There are no orders</h3>
        <p class="text-gray-600 mb-6">This provider has no orders added. Do you want to add one now?</p>
        <%= link_to new_order_path, class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-[#7C5BF3] hover:bg-[#9576F5] text-white transition-colors" do %>
          <%= tabler_icon('user-plus', size: '15') %>
          Add order
        <% end %>
      </div>
    <% end %>
  </div>
</div>
