<% content_for :title, "Orders" %>
<div class="w-full mx-auto p-3">
  <%= render Shared::NavigationComponent.new(title: "Orders", subtitle: "Manage your orders") do |nav| %>
    <% nav.with_button(
      path: new_order_path,
      text: "Add order",
      icon: "plus",
    ) %>
  <% end %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <%= render "orders/components/summary" %>
  <% if @orders.any? %>
    <div id="orders" class="overflow-hidden p-2 rounded-lg border bg-white border-gray-200 shadow">
      <section class="relative overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order number</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render @orders %>
          </tbody>
        </table>
      </section>
    </div>
  <% else %>
    <%= render Shared::EmptyStateComponent.new(
      title: "There are no orders",
      description: "This provider has no orders added. Do you want to add one now?",
      icon: "clipboard-check",
      icon_button: "plus",
      path: new_order_path,
      text: "Create order"
    ) %>
  <% end %>
</div>
