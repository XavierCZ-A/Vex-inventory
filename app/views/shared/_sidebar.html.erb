<aside data-controller="sidebar">
  <nav class="w-64 h-full bg-white border border-gray-200 shadow-lg flex flex-col justify-between">
    <div>
      <div class="flex items-center space-x-3 my-5 p-2">
        <div class="flex flex-col text-start overflow-hidden">
          <h2 class="text-xl font-semibold">
            <span class="text-blue-500">Prod</span>Manager
          </h2> 
          <span class="overflow-ellipsis text-xs">Enterprise</span>
        </div>
        <button type="button" data-action="sidebar#toggle" class="ml-auto text-gray-500 hover:text-gray-700 border border-gray-200 hover:bg-gray-100 rounded-md p-1">
          <%= tabler_icon("chevron-left", size: 15) %>
        </button>
      </div>
      <ul class="space-y-2 p-3">
        <li>
          <%= sidebar_link(text: "Products", path: products_path, icon_name: 'cube') %>
        </li>
        <li>
          <%= sidebar_link(text: "Warehouses", path: warehouses_path, icon_name: 'building-warehouse') %>
        </li>
        <li>
          <%= sidebar_link(text: "Suppliers", path: suppliers_path, icon_name: 'truck') %>
        </li>
        <li>
          <%= sidebar_link(text: "Orders", path: orders_path, icon_name: 'clipboard-check') %>
        </li>
        <li>
          <%= sidebar_link(text: "Customers", path: customers_path, icon_name: 'users') %>
        </li>
        <li>
          <%= sidebar_link(text: "Invitations", path: invitations_path, icon_name: 'user-plus') if Current.user.admin? %>
        </li>
        <li>
          <%= sidebar_link(text: "Employees", path: employees_path, icon_name: 'users-group') if Current.user.admin? %>
        </li>
      </ul>
    </div>
    <div>
      <hr class="w-full border-[#bfc5d2] mb-3" />
      <div class="flex items-center space-x-3 text-sm rounded-lg p-2">
        <div class="flex shrink-0 overflow-hidden rounded-lg">
          <%= user_avatar(Current.user.name) %>
        </div>
        <div class="flex flex-col text-start leading-tight overflow-hidden">
          <span class="overflow-ellipsis max-i-full font-semibold"><%= Current.user.full_name %></span>
          <span class="overflow-ellipsis max-i-full text-xs"><%= Current.user.email_address %></span>
        </div>
      </div>
      <div class="p-1">
        <%= link_to session_path(Current.user.id), data: { turbo_method: :delete }, class: "flex items-center space-x-3 text-sm text-primary rounded-lg p-2" do %>
          <%= tabler_icon('logout', size: '20', color: "text-primary") %>
          <span> Logout </span>
        <% end %>
      </div>
    </div>
  </nav>
</aside>
