<aside>
  <nav class="w-64 h-full border border-gray-200 shadow-lg flex flex-col justify-between">
    <div>
      <%= link_to "#", class: "flex items-center space-x-3 my-5 p-2 rounded-lg hover:bg-gray-100" do %>
        <div>
          <%= tabler_icon("box", size: 35) %>
        </div>
        <div class="flex flex-col text-start leading-tight overflow-hidden">
          <h2 className="text-xl font-semibold animate-fade-in">
            <span>Prod</span>Manager
          </h2> 
          <span class="overflow-ellipsis text-xs">Enterprise</span>
        </div>
        <div class="ml-auto mr-5">
          <%= tabler_icon("caret-up-down", size: 15) %>
        </div>
      <% end %>
      <ul class="space-y-10 p-3">
        <li>
          <%= sidebar_link(text: "Products", path: products_path, icon_name: 'cube') %>
        </li>
        <li>
          <%= sidebar_link(text: "Warehouses", path: warehouses_path, icon_name: 'building-warehouse') %>
        </li>
        <li>
          <%= sidebar_link(text: "Suppliers", path: suppliers_path, icon_name: 'truck') %>
        </li>
        <li>
          <%= sidebar_link(text: "Orders", path: orders_path, icon_name: 'clipboard-check') %>
        </li>
        <li>
          <%= sidebar_link(text: "Customers", path: customers_path, icon_name: 'users') %>
        </li>
      </ul>
    </div>
    <div class="p-2">
      <%= link_to session_path(Current.user.id), data: { turbo_method: :delete, turbo_confirm: 'Are you sure' } ,class: "flex items-center space-x-3 text-sm text-white rounded-lg p-3 bg-[#FFA766] hover:bg-[#FF8A33]" do %>
        <%= tabler_icon('logout', size: '20', color: "#ffffff") %>
        <span> Logout </span>
      <% end %>
    </div>
  </nav>
</aside>
