<div data-controller="flash">
  <% if alert || notice %>
    <% color = alert ? 'text-black' : 'text-black' %>
    <% flash_type = alert ? 'text-black text-sm bg-gray-100' : 'text-black text-sm bg-gray-100' %>
    <div class="fixed top-4 right-4 max-w-sm">
      <div class="flex items-center space-x-4 shadow-lg rounded px-4 py-3 opacity-100 <%= flash_type %>" data-flash-target="flash">
        <div class=" <%= color %>">
          <% if alert %>
            <%= tabler_icon('alert-triangle', size: '15') %>
          <% else %>
            <%= tabler_icon('checkbox', size: '15') %>
          <% end %>
        </div>
        <p>
          <%= alert || notice %>
        </p>
        <button class="inline-flex focus:outline-none focus:text-gray-300 transition ease-in-out duration-150" data-action="click->flash#close">
        </button>
      </div>
    </div>
  <% end %>
</div>