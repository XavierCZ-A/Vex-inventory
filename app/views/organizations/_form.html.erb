
<%= form_with(model: organization, class: "contents") do |form| %>
  <% if organization.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(organization.errors.count, "error") %> prohibited this organization from being saved:</h2>

      <ul class="list-disc ml-6">
        <% organization.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.fields_for :users do |user_form| %>
      <div class="flex justify-center items-center font-[sans-serif] h-full md:min-h-screen p-4">
        <main class="grid justify-center max-w-md mx-auto">
          <div class="bg-white rounded-2xl p-6 -mt-24 relative z-10 shadow-[0_2px_16px_-3px_rgba(6,81,237,0.3)]">
            <div class="mb-12">
              <h1 class="text-3xl font-extrabold text-primary">Sign in</h1>
            </div>
            <section>
              <div class="relative w-full flex items-center">
                <%= form.label :name, class: "sr-only" %>
                <%= form.text_field :name, placeholder: "Company", autofocus: true, class: "w-full text-gray-800 text-sm border-b border-gray-300 focus:border-blue-600 px-2 py-3 outline-none" %>
                <%= tabler_icon('building-community', size: '20', class: "w-[18px] h-[18px] absolute right-2 cursor-pointer") %>
               </div>
            </section>
            <section class="flex space-x-3">
              <div class="relative flex items-center">
                <%= user_form.label :name, class: "sr-only" %>
                <%= user_form.text_field :name, placeholder: "Name", autofocus: true, class: "w-full text-gray-800 text-sm border-b border-gray-300 focus:border-blue-600 px-2 py-3 outline-none" %>
                <%= tabler_icon('user', size: '20', class: "w-[18px] h-[18px] absolute right-2 cursor-pointer") %>
              </div>

              <div class="relative flex items-center my-5">
                <%= user_form.label :last_name, class: "sr-only" %>
                <%= user_form.text_field :last_name, placeholder: "Last name", autofocus: true, class: "w-full text-gray-800 text-sm border-b border-gray-300 focus:border-blue-600 px-2 py-3 outline-none" %>
                <%= tabler_icon('user', size: '20', class: "w-[18px] h-[18px] absolute right-2 cursor-pointer") %>
              </div>
            </section>

            <section class="relative flex items-center">
              <%= user_form.label :email_address, class: "sr-only" %>
              <%= user_form.email_field :email_address, placeholder: "Email", autofocus: true, class: "w-full text-gray-800 text-sm border-b border-gray-300 focus:border-blue-600 px-2 py-3 outline-none" %>
              <%= tabler_icon('mail', size: '20', class: "w-[18px] h-[18px] absolute right-2 cursor-pointer") %>
            </section>

            <section class="relative flex items-center my-5">
              <%= user_form.label :password, class: "sr-only" %>
              <%= user_form.password_field :password, placeholder: "Password", autofocus: true, class: "w-full text-gray-800 text-sm border-b border-gray-300 focus:border-blue-600 px-2 py-3 outline-none" %>
              <%= tabler_icon('eye', size: '20', class: "w-[18px] h-[18px] absolute right-2 cursor-pointer") %>
            </section>

            <section class="flex items-center">
              <%= user_form.submit "Sign up", class: "flex w-full justify-center rounded-md bg-primary px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            </section>
          </div>
        </main>
      </div>
    <% end %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
