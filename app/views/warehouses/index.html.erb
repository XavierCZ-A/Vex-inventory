<% content_for :title, "Warehouses" %>

<div class="w-full h-full overflow-hidden p-3 overflow-y-auto scrollbar-hide">
  <%= render Shared::NavigationComponent.new(title: "Warehouses", subtitle: "Manage your warehouses and distribution centers") do |nav| %>
    <% nav.with_button(
      path: new_warehouse_path,
      text: "Add warehouse",
      icon: "plus",
      turbo_frame: "modal"
    ) %>
  <% end %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-3" />
  <%= render "warehouses/components/summary" %>
  <div id="warehouses" class="flex flex-wrap gap-4">
    <% if @warehouses.any? %>
      <% @warehouses.each do |warehouse| %>
        <%= render warehouse %>
      <% end %>
  </div>
  <% else %>
    <%= render Shared::EmptyStateComponent.new(
      title: "There are no warehouse",
      description: "This provider has no warehouse added. Do you want to add one now?",
      icon: "building-warehouse",
      icon_button: "plus",
      path: new_warehouse_path,
      text: "Add warehouse",
      turbo_frame: "modal"
    ) %>
<% end %>
</div>
