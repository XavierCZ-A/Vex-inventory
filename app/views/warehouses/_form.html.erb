<%= form_with(model: warehouse, class: "contents flex flex-col items-center w-full") do |form| %>
  <div class="flex w-full items-center space-x-2">
    <div class="w-full">
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <%= render Ui::InputComponent.new(
          form: form,
          attribute: :name,
          icon: "building-warehouse",
          placeholder: "Nombre del almacén",
          type: :text
        ) %>
      </div>
      <%= display_field_errors(warehouse, :name) %>
    </div>

    <div class="w-full">
      <%= form.label :capacity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <%= render Ui::InputComponent.new(
          form: form,
          attribute: :capacity,
          icon: "building-warehouse",
          placeholder: "Capacidad del almacén",
          type: :text
        ) %>
      </div>
      <%= display_field_errors(warehouse, :capacity) %>
    </div>
  </div>

  <div class="w-full mx-auto my-5">
    <%= form.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :address,
        icon: "map-pin",
        placeholder: "Dirección del almacén",
        type: :text
      ) %>
    </div>
    <%= display_field_errors(warehouse, :address) %>
  </div>

  <div class="mt-4 ml-auto">
    <%= form.submit class: "button" %>
  </div>
<% end %>
