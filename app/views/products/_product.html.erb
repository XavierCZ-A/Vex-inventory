<div id="<%= dom_id product %>" class="w-full sm:w-auto space-y-5">
  <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
      <%= link_to product_path(product),
                  class: "text-sm font-medium hover:underline transition duration-200 cursor-pointer" do %>
        <%= product.name %>
      <% end %>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= number_to_currency(product.price) %>
      </p>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= product.stocks.sum(:quantity) || "Sin stock" %>
      </p>
    </td>
    
    <td class="px-6 py-4">
      <span class="<%= category_color(product.category.name) %> px-2 py-1 rounded-full text-xs">
        <%= product.category.name %>
      </span>
    </td>
    <td class="px-6 py-4 flex space-x-2 justify-center">
      <%= link_to edit_product_path(product), class: "text-gray-600 hover:text-gray-800 p-2", data: { turbo_frame: "modal" } do %>
        <%= tabler_icon('edit', size: '20', class: "mr-2") %>
      <% end %>
      <%= button_to product, method: :delete, class: 'text-gray-600 hover:text-gray-800 p-2' do %>
        <%= tabler_icon('trash', size: '20', class: "mr-2") %>
      <% end %>
    </td>
  </tr>
</div>

