<%= form_with(model: product, class: "contents flex flex-col items-center w-full", data: { controller: "sizes-fields" }) do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3 w-80">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul class="list-disc ml-6">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="w-full mx-auto mb-5">
    <div class="flex items-center space-x-2">
      <%= form.label :sku, "SKU", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= button_tag type: "button", title: "El SKU es un código único que identifica a cada producto en tu inventario. Ej: CAM-AZL-M: Camisa Azul Mediana" do %>
        <%= tabler_icon('help', size: '17', class: "text-primary mb-1") %>
      <% end %>
    </div>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :sku,
        icon: "file-barcode",
        placeholder: "Ej: CAM-AZL-M",
        type: :text
      ) %>
    </div>
  </div>

  <div class="w-full mb-5">
    <%= form.fields_for :stocks do |stock_form| %>
      <%= render 'products/components/stock_fields', f: stock_form %>
    <% end %>
  </div>

  <div class="w-full mx-auto">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :name,
        icon: "package",
        placeholder: "Nombre del producto",
        type: :text
      ) %>
    </div>
  </div>

  <div class="my-8 w-full mx-auto">
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::TextAreaComponent.new(
        form: form,
        attribute: :description,
        placeholder: "Descripción del producto",
        rows: 4
      ) %>
    </div>
  </div>

  <div class="flex w-full items-center space-x-2">
    <div class="w-full">
      <%= form.label :category_id, for: 'floating_category_id', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('tag', size: '15', class: "text-primary") %>
        </div>
        <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, { id: 'floating_category_id', class: "block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>
    </div>

    <div class="w-full">
      <%= form.label :price, "Price ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <%= render Ui::InputComponent.new(
          form: form,
          attribute: :price,
          icon: "currency-dollar",
          placeholder: "0.00",
          type: :number
        ) %>
      </div>
    </div>
  </div>

  <div class="mt-4 ml-auto">
    <%= form.submit class: "button" %>
  </div>
<% end %>