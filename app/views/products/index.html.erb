<% content_for :title, "Products" %>
<main class="container mx-auto p-3 h-full overflow-y-auto scrollbar-hide">
  <%= render "products/components/navigation" %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-3" />
  <%= render "products/components/summary" %>
  <div class="overflow-hidden p-2 rounded-lg border border-gray-200 shadow">
    <% if @products.any? %>
    <section class="mt-3 relative overflow-x-auto">
      <table class="min-w-full bg-white">
        <thead>
        <tr class="border-b border-[#E5E7EB]">
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Product
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            SKU
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Price
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Stock
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Category
          </th>
          <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
            Actions
          </th>
        </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <%= render partial: 'product', collection: @products, cached: true %>
        </tbody>
      </table>
    </section>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(
        title: "There are no products",
        description: "This provider has no products added. Do you want to add one now?",
        icon: "box",
        icon_button: "plus",
        path: new_product_path,
        text: "Add product",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
  <% if @count_products > 5 %>
    <%== pagy_nav(@pagy) %>
  <% end %>
</main>