<% content_for :title, "Products" %>
<main class="container mx-auto p-3 h-full overflow-y-auto scrollbar-hide">
  <%= render Shared::NavigationComponent.new(title: "Products", subtitle: "Manage your product catalog") do |nav| %>
    <% nav.with_button(
      path: products_path(format: :csv),
      text: "Export products",
      icon: "file-type-csv",
      turbo_frame: "modal",
      variant: :primary
    ) %>
    <% nav.with_button(
      path: new_product_path,
      text: "Add product",
      icon: "plus",
      turbo_frame: "modal",
      variant: :primary
    ) %>
    <% nav.with_button(
      path: new_stock_path,
      text: "Add stock",
      icon: "plus",
      turbo_frame: "modal",
      variant: :primary
    ) %>
  <% end %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-3" />
  <%= render "products/components/summary" %>
  <%= render "products/components/filters" %>
  <% if @products.any? %>
    <section class="overflow-hidden p-3 bg-white rounded-lg border border-gray-200 shadow">
      <table class="min-w-full bg-white">
        <div class="flex justify-between items-center">
          <h1 class="text-2xl font-bold p-3">List of products</h1>
          <span class="text-sm text-gray-500 mr-3">
            <%= @products.count %> products out of <%= @count_products %>
          </span>
        </div>
        <thead>
          <tr class="border-b border-[#E5E7EB]">
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Product
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              SKU
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Price
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Stock
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Category
            </th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <%= render partial: 'product', collection: @products, cached: true %>
        </tbody>
      </table>
    </section>
  <% else %>
    <%= render Shared::EmptyStateComponent.new(
      title: "There are no products",
      description: "This provider has no products added. Do you want to add one now?",
      icon: "box",
      icon_button: "plus",
      path: new_product_path,
      text: "Add product",
      turbo_frame: "modal"
    ) %>
  <% end %>
  <% if @count_products > 5 %>
    <%== pagy_nav(@pagy) %>
  <% end %>
</main>