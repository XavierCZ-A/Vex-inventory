  <div class="flex w-full items-center space-x-2">
    <div class="w-full">
      <%= f.label :warehouse_id, for: 'warehouse_id', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('building-warehouse', size: '15', class: "text-primary") %>
        </div>
        <%= f.collection_select :warehouse_id, Warehouse.order(:name), :id, :name, { prompt: "Select a warehouse" }, { id: 'warehouse_id', class: "block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" } %>
      </div>
    </div>

    <div class="w-full">
      <%= f.label :quantity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
        form: f,
          attribute: :quantity,
          icon: "stack-3",
          placeholder: "0",
          type: :number
        ) %>
      </div>
    </div>
  </div>