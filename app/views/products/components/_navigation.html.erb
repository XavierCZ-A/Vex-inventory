<nav class="flex items-center mb-6">
  <h1 class="text-4xl font-extrabold text-gray-800">
    Productos
    <span class="block text-lg font-medium text-gray-500 mt-1">
      Gestiona tu catálogo de productos
    </span>
  </h1>
  <div class="flex items-center space-x-2 ml-auto">
    <%= link_to products_path(format: :csv), class: "principal-button" do %>
      <%= tabler_icon('file-type-csv', size: '20', class: "mr-2") %>
      Export products
    <% end %>
    <%= link_to new_product_path, class: 'principal-button' do %>
      <%= tabler_icon('stack-3', size: '20', class: "mr-2") %>
      Add stock
    <% end %>
    <%= link_to new_product_path,
                data: { turbo_frame: 'modal' },
                class: 'principal-button' do %>
      <%= tabler_icon('plus', size: '20', class: "mr-2") %>
      Add product
    <% end %>
  </div>
</nav>

