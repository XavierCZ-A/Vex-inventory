<nav class="flex items-center mb-6">
  <h1 class="text-2xl font-extrabold text-gray-800">
    Products
    <span class="block text-sm font-medium text-gray-500 mt-1">
      Manage your product catalog
    </span>
  </h1>
  <div class="flex items-center space-x-2 ml-auto">
    <%= link_to products_path(format: :csv), class: "principal-button" do %>
      <%= tabler_icon('file-type-csv', size: '20', class: "mr-2") %>
      Export products
    <% end %>
    <%= link_to new_product_path,
                data: { turbo_frame: 'modal' },
                class: 'principal-button' do %>
      <%= tabler_icon('plus', size: '20', class: "mr-2") %>
      Add product
    <% end %>
  </div>
</nav>

