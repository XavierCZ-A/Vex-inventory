<section aria-label="Resumen del inventario" class="flex justify-between items-start my-8">
  <article class="summary-card">
    <h2 class="text-sm text-gray-500 mb-2">Total de Productos</h2>
    <div class="flex items-center justify-between">
      <p class="text-2xl font-bold"><%= @products.count %></p>
      <span class="bg-blue-100 rounded-full p-2">
        <%= tabler_icon("box", size: 30, class: "text-blue-500") %>
      </span>
    </div>
  </article>

  <article class="summary-card">
    <h2 class="text-lg text-gray-500 mb-2">En stock</h2>
    <div class="flex items-center justify-between">
      <p class="text-2xl font-bold"><%= number_with_delimiter(@total_stock) %></p>
      <span class="bg-blue-100 rounded-full p-2">
        <%= tabler_icon("stack-2", size: 30, class: "text-blue-500") %>
      </span>
    </div>
  </article>

  <article class="summary-card">
    <h2 class="text-lg text-gray-500 mb-2">Valor del inventario</h2>
    <div class="flex items-center justify-between">
      <p class="text-2xl font-bold"><%= number_to_currency(@total_products_price) %></p>
      <span class="bg-green-100 rounded-full p-2">
        <%= tabler_icon("currency-dollar", size: 30, class: "text-green-500") %>
      </span>    
    </div>
  </article>

  <article class="summary-card">
    <h2 class="text-lg text-gray-500 mb-2">Agotados</h2>
    <div class="flex items-center justify-between">
      <p class="text-2xl font-bold"><%= number_with_delimiter(@total_stock) %></p>
      <span class="bg-blue-100 rounded-full p-2">
        <%= tabler_icon("box", size: 30, class: "text-blue-500") %>
      </span>    
    </div>
  </article>
</section>
