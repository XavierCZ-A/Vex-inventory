<%= render(Shared::SummaryCardComponent.new(title: "Resumen de Productos")) do |dashboard| %>
  <% dashboard.with_card(
    title: "Total de Productos",
    value: @count_products,
    icon: "box"
  ) %>
  
  <% dashboard.with_card(
    title: "En stock",
    value: @total_stock,
    icon: "stack-2",
    formatter: :delimiter
  ) %>
  
  <% dashboard.with_card(
    title: "Valor del inventario",
    value: @total_products_price,
    icon: "currency-dollar",
    color: "green",
    formatter: :currency
  ) %>
<% end %>
