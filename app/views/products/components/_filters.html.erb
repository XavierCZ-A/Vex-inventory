<nav class="mb-5">
  <%= form_with url: products_path, method: :get do |form| %>
    <div class="flex justify-between items-center space-x-4">
      <div class="relative w-3/4">
        <%= form.text_field :query_text, placeholder: 'Search', onChange: 'this.form.requestSubmit()', value: params[:query_text], class: "w-full py-2 pl-10 pr-4 text-gray-700 bg-white border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-300" %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('search', size: '20', class: "mr-2") %>
        </div>
      </div>
      <div class="relative w-1/4">
        <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: 'Select a category', include_blank: true }, { onChange: 'this.form.requestSubmit()', class: "w-full py-2 pl-10 pr-4 text-gray-700 bg-white border border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors duration-300" } %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('category', size: '20', class: "mr-2") %>
        </div>
      </div>
    </div>
  <% end %>
</nav>
