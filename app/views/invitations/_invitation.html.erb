<div id="<%= dom_id invitation %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
      <td class="px-6 py-4">
        <div class="flex items-center gap-2">
            <%= user_avatar(invitation.name, color ="#f0edec", text_color = "black") %>
            <p class="text-sm font-medium"><%= invitation.name %></p>
        </div>
      </td>
      <td class="px-6 py-4">
        <p class="text-sm font-medium text-gray-900">
          <%= invitation.email %>
        </p>
      </td>
      <td class="px-6 py-4">
        <span class="<%= status_color_invitation(invitation.status) %> px-2 py-1 rounded-full text-xs">
          <%= invitation.status %>
        </span>
      </td>
      <td class="px-6 py-4">
        <% if invitation.status == "pending" %>
          <%= button_to resend_invitation_path(invitation), 
          method: :post, 
          class: "button-secondary-icon" do %>
            <%= tabler_icon('mail', size: '15', class: "mr-2") %>
              <span>Resend</span>
          <% end %>
        <% end %>
      </td>
  </tr>
</div>
