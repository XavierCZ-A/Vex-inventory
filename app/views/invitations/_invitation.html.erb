<div id="<%= dom_id invitation %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
        <div class="flex items-center gap-2">
            <%= user_avatar(invitation.name, color ="#f0edec", text_color = "black") %>
            <p class="text-sm font-medium"><%= invitation.name %></p>
        </div>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= invitation.email %>
      </p>
    </td>
    <td class="px-6 py-4">
      <span class="<%= status_color_invitation(invitation.status) %> px-2 py-1 rounded-full text-xs">
        <%= invitation.status %>
      </span>
    </td>
    
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= invitation.organization.name %>
      </p>
    </td>
    <td class="px-6 py-4 flex space-x-2 justify-center">
      <%= link_to invitations_path(invitation), class: "text-gray-600 hover:text-gray-800 p-2 ", data: { turbo_frame: "modal" } do %>
        <%= tabler_icon('edit', size: '20', class: "mr-2") %>
      <% end %>
      <%= button_to invitations_path, method: :delete, class: 'text-gray-600 hover:text-gray-800 p-2' do %>
        <%= tabler_icon('trash', size: '20', class: "mr-2") %>
      <% end %>
    </td>
  </tr>
</div>
