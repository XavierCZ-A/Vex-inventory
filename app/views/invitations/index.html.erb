<% content_for :title, "Invitations" %>

<div class="w-full mx-auto p-3">
  <%= render Shared::NavigationComponent.new(title: "Invitations", subtitle: "Manage your team's access to the platform  ") do |nav| %>
    <% nav.with_button(
      path: new_invitation_path,
      text: "Add invitation",
      icon: "plus",
      turbo_frame: "modal"
    ) %>
  <% end %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <div id="purchase_orders" class="min-w-full">
    <% if @invitations.any? %>
      <section class="overflow-hidden p-2 rounded-lg bg-white border border-gray-200 shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render @invitations %>
          </tbody>
        </table>
      </section>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(
        title: "There are no invitations",
        description: "This provider has no invitations added. Do you want to invite one now?",
        icon: "user-plus",
        icon_button: "plus",
        path: new_invitation_path,
        text: "Invite employee",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
</div>