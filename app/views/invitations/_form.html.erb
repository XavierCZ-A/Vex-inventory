<%= form_with(model: invitation, class: "contents flex flex-col items-center w-full gap-5") do |form| %>
  <div class="w-full mx-auto">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
          form: form,
          attribute: :name,
          icon: "user",
          placeholder: "Nombre completo",
          type: :text
        ) %>
    </div>
    <%= display_field_errors(invitation, :name) %>
  </div>

  <div class="w-full mx-auto">
    <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :email,
        icon: "mail",
        placeholder: "Correo electrónico",
        type: :text
        ) %>
    </div>
    <%= display_field_errors(invitation, :email) %>
    <p class="text-sm text-gray-500 mt-2">The user will receive an email with a link to sign up.</p>
  </div>

  <div class="mt-4 ml-auto">
    <%= form.submit class: "button" %>
  </div>
<% end %>
