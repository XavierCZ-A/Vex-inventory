<%= form_with(model: invitation, class: "contents flex flex-col items-center w-full") do |form| %>
  <% if invitation.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3 w-80">
      <h2><%= pluralize(invitation.errors.count, "error") %> prohibited this invitation from being saved:</h2>

      <ul class="list-disc ml-6">
        <% invitation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="w-full mx-auto my-5">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= render Ui::InputComponent.new(
      form: form,
      attribute: :name,
      icon: "user",
      placeholder: "Nombre del completo",
      type: :text
    ) %>
  </div>

  <div class="w-full mx-auto my-5">
    <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= render Ui::InputComponent.new(
      form: form,
      attribute: :email,
      icon: "mail",
      placeholder: "Correo electrónico",
      type: :text
    ) %>
    <p class="text-sm text-gray-500 mt-2">The user will receive an email with a link to sign up.</p>
  </div>

  <div class="mt-4 ml-auto">
    <%= form.submit class: "flex items-center text-white bg-[#7C5BF3] hover:bg-[#9576F5] rounded-lg p-3" %>
  </div>
<% end %>
