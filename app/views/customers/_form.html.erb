<%= form_with(model: customer, class: "contents flex flex-col items-center w-full") do |form| %>
  <% if customer.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:</h2>

      <ul class="list-disc ml-6">
        <% customer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <div class="w-full mx-auto">
    <%= form.label :name, "Nombre completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('user', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :name,
      placeholder: "Nombre y Apellidos",
      class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": customer.errors[:name].none?, "border-red-400 focus:outline-red-600": customer.errors[:name].any? }] %>
    </div>
  </div>


  <div class="flex w-full items-center space-x-2 my-5">
    <div class="w-full">
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('mail', size: '15', class: "text-[#7C5BF3]") %>
        </div>
        <%= form.text_field :email,
        placeholder: "Correo electronico",
        class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": customer.errors[:email].none?, "border-red-400 focus:outline-red-600": customer.errors[:email].any? }] %>
      </div>
    </div>

    <div class="w-full">
      <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="mt-1 relative rounded-md shadow-sm w-full">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <%= tabler_icon('phone', size: '15', class: "text-[#7C5BF3]") %>
        </div>
        <%= form.text_field :phone,
        placeholder: "+52 XX XXXX XXXX",
        class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": customer.errors[:phone].none?, "border-red-400 focus:outline-red-600": customer.errors[:phone].any? }] %>
      </div>
    </div>
  </div>

  <div class="w-full mx-auto">
    <%= form.label :company_name, "Empresa (Opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('building', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :company_name,
      placeholder: "Nombre de la empresa",
      class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": customer.errors[:company_name].none?, "border-red-400 focus:outline-red-600": customer.errors[:company_name].any? }] %>
    </div>
  </div>

  <div class="w-full mx-auto my-5">
    <%= form.label :address, "Direccion (Opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('map-pin', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :address,
      placeholder: "Calle principal #123, Colonia centro",
      class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": customer.errors[:address].none?, "border-red-400 focus:outline-red-600": customer.errors[:address].any? }] %>
    </div>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
