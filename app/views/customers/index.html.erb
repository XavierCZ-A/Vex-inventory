<% content_for :title, "Customers" %>
<div class="w-full mx-auto p-3">
  <%= render Shared::NavigationComponent.new(title: "Customers", subtitle: "Manage your customers") do |nav| %>
    <% nav.with_button(
      path: new_customer_path,
      text: "Add customer",
      icon: "plus",
      turbo_frame: "modal"
    ) %>
  <% end %>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <div id="purchase_orders" class="min-w-full">
    <% if @customers.any? %>
      <section class="overflow-hidden p-2 rounded-lg bg-white border border-gray-200 shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Customer</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Phone</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Address</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render @customers %>
          </tbody>
        </table>
      </section>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(
        title: "There are no customers",
        description: "This provider has no customers added. Do you want to add one now?",
        icon: "users",
        icon_button: "plus",
        path: new_customer_path,
        text: "Add customer",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
</div>
