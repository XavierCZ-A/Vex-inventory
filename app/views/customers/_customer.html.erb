<div id="<%= dom_id customer %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
      <div class="flex items-center space-x-2">
        <%= user_avatar(customer.name) %>
        <div class="flex flex-col">
          <%= customer.name %>
          <span class="text-xs font-medium text-gray-400 flex items-center">
            <%= tabler_icon('mail', size: '14', class: "mr-1") %>
            <%= customer.email %>
          </span>
        </div>
      </div>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= customer.phone %>
      </p>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= customer.address %>
      </p>
    </td>
    <td class="px-6 py-4 flex space-x-2 justify-center">
      <%= link_to edit_customer_path(customer), class: "text-gray-600 hover:text-gray-800 p-2 ", data: { turbo_frame: "modal" } do %>
        <%= tabler_icon('edit', size: '20', class: "mr-2") %>
      <% end %>
      <%= button_to customer, method: :delete, class: 'text-gray-600 hover:text-gray-800 p-2' do %>
        <%= tabler_icon('trash', size: '20', class: "mr-2") %>
      <% end %>
    </td>
  </tr>
</div>
