<div id="<%= dom_id customer %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
      <%= link_to customer_path(customer),
                  class: "text-sm font-medium hover:underline transition duration-200 cursor-pointer" do %>
        <%= customer.name %>
      <% end %>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= customer.phone %>
      </p>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= customer.email %>
      </p>
    </td>
    
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= customer.address %>
      </p>
    </td>
    <td class="px-6 py-4 flex space-x-2 justify-center">
      <%= link_to edit_customer_path(customer), class: "text-black p-2 " do %>
        <%= tabler_icon('edit', size: '20', class: "mr-2") %>
      <% end %>
      <%= button_to customer, method: :delete, class: 'text-black p-2' do %>
        <%= tabler_icon('trash', size: '20', class: "mr-2") %>
      <% end %>
    </td>
  </tr>
</div>
