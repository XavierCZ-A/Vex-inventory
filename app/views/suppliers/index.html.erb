<% content_for :title, "Suppliers" %>
<div class="w-full mx-auto p-3">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Suppliers</h1>
    <% if @suppliers.any? %>
      <%= render Ui::ButtonComponent.new(
        path: new_supplier_path,
        text: "Add supplier",
        icon: "plus",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <div id="purchase_orders" class="min-w-full">
    <% if @suppliers.any? %>
      <section class="overflow-hidden p-2 rounded-lg border border-gray-200 shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Supplier</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Phone</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-1/4">Address</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render @suppliers %>
          </tbody>
        </table>
      </section>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(
        title: "There are no suppliers",
        description: "This provider has no suppliers added. Do you want to add one now?",
        icon: "users-group",
        icon_button: "plus",
        path: new_supplier_path,
        text: "Add supplier",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
</div>
