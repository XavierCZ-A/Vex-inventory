<tr id="<%= dom_id supplier %>" class="bg-white hover:bg-gray-200">
  <td class="px-6 py-4 whitespace-nowrap w-1/4">
    <%= link_to supplier_path(supplier), class: "text-sm font-medium hover:underline transition duration-200 cursor-pointer" do %>
      <%= supplier.company_name %>
    <% end %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap w-1/4">
    <p class="text-sm font-medium text-gray-900"><%= supplier.supplier_name %></p>
  </td>
  <td class="px-6 py-4 whitespace-nowrap w-1/4">
    <p class="text-sm text-[#7C5BF3] hover:text-[#9576F5] font-medium hover:underline transition duration-200 cursor-pointer">
      <%= supplier.supplier_email %>
    </p>
  </td>
  <td class="px-6 py-4 whitespace-nowrap w-1/4">
    <p class="text-sm font-medium text-gray-900"><%= supplier.supplier_phone %></p>
  </td>
  <td class="whitespace-nowrap w-1/4">
  <%= link_to purchase_orders_supplier_path(supplier),
              data: { turbo_frame: "modal" },
              class: "text-sm font-medium hover:underline transition duration-200 cursor-pointer" do %>
    <%= tabler_icon('shopping-cart', size: '17', class: "text-[#7C5BF3] mb-1") %>
  <% end %>
</td>
</tr>
