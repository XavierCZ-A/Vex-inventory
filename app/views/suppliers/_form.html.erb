<%= form_with(model: supplier, class: "contents") do |form| %>
  <% if supplier.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(supplier.errors.count, "error") %> prohibited this supplier from being saved:</h2>

      <ul class="list-disc ml-6">
        <% supplier.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :company_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('building-warehouse', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :company_name, class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:company_name].none?, "border-red-400 focus:outline-red-600": supplier.errors[:company_name].any?}] %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :supplier_email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('mail', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :supplier_email, class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:supplier_email].none?, "border-red-400 focus:outline-red-600": supplier.errors[:supplier_email].any?}] %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :supplier_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('user', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :supplier_name, class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:supplier_name].none?, "border-red-400 focus:outline-red-600": supplier.errors[:supplier_name].any?}] %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :supplier_phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('phone', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :supplier_phone, class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:supplier_phone].none?, "border-red-400 focus:outline-red-600": supplier.errors[:supplier_phone].any?}] %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :supplier_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= tabler_icon('map-pins', size: '15', class: "text-[#7C5BF3]") %>
      </div>
      <%= form.text_field :supplier_address, class: ["block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:supplier_address].none?, "border-red-400 focus:outline-red-600": supplier.errors[:supplier_address].any?}] %>
    </div>
  </div>
  
  <div class="my-3">
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <%= form.textarea :notes, rows: 4, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:notes].none?, "border-red-400 focus:outline-red-600": supplier.errors[:notes].any? }] %>
    </div>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>