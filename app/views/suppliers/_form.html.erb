<%= form_with(model: supplier, class: "contents flex flex-col items-center w-full", data: { controller: "sizes-fields" }) do |form| %>
  <% if supplier.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3 w-80">
      <h2><%= pluralize(supplier.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul class="list-disc ml-6">
        <% supplier.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex w-full items-center space-x-2">
    <div class="w-full">
      <%= form.label :company_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :company_name,
        icon: "building",
        placeholder: "Nombre de la empresa",
        type: :text
      ) %>
    </div> 

    <div class="w-full">
      <%= form.label :supplier_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :supplier_name,
        icon: "user",
        placeholder: "Nombre completo",
        type: :text
      ) %>
    </div> 
  </div>

  <div class="flex w-full items-center space-x-2 my-5">
    <div class="w-full">
      <%= form.label :supplier_email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :supplier_email,
        icon: "mail",
        placeholder: "email@example.com",
        type: :email
      ) %>
    </div> 

    <div class="w-full">
      <%= form.label :supplier_phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :supplier_phone,
        icon: "phone",
        placeholder: "+52 XX XXXX XXXX",
        type: :text
      ) %>
    </div> 
  </div>

  <div class="w-full mx-auto">
    <%= form.label :supplier_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= render Ui::InputComponent.new(
      form: form,
      attribute: :supplier_address,
      icon: "map-pin",
      placeholder: "Direccion completa",
      type: :text
    ) %>
  </div>

  <div class="my-8 w-full mx-auto">
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm w-full">
      <%= form.textarea :notes, rows: 4,
      placeholder: "Informacion adicional del proveedor",
      class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full focus:ring-indigo-500 focus:border-indigo-500", { "border-gray-400 focus:outline-blue-600": supplier.errors[:description].none?, "border-red-400 focus:outline-red-600": supplier.errors[:description].any? }] %>
    </div>
  </div>



  <div class="mt-4 ml-auto">
    <%= form.submit class: "flex items-center text-white bg-[#7C5BF3] hover:bg-[#9576F5] rounded-lg p-3" %>
  </div>
<% end %>