<%= form_with(model: stock, class: "contents flex flex-col items-center w-full gap-5") do |form| %>

  <div class="w-full">
    <%= form.label :quantity, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="mt-1 relative rounded-md shadow-sm">
      <%= render Ui::InputComponent.new(
        form: form,
        attribute: :quantity,
        icon: "circle-number-1",
        placeholder: "Cantidad",
        type: :number
      ) %>
    </div>
    <%= display_field_errors(stock, :quantity) %>
  </div>

  <div class=" w-full">
    <%= form.label :product_id, for: 'floating_product_id', class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= render CollectionSelectComponent.new(
      form: form,
      attribute: :product_id,
      collection: Product.order(:name),
      value_method: :id,
      text_method: :name,
      prompt: "Selecciona un producto",
      icon: "box",
    ) %>
    <%= display_field_errors(stock, :product_id) %>
  </div>

  <div class="w-full">
    <%= form.label :warehouse_id, for: 'floating_warehouse_id', class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= render CollectionSelectComponent.new(
      form: form,
      attribute: :warehouse_id,
      collection: Warehouse.order(:name),
      value_method: :id,
      text_method: :name,
      prompt: "Selecciona un almacen",
      icon: "building-warehouse",
    ) %>
    <%= display_field_errors(stock, :warehouse_id) %>
  </div>

  <div class="mt-4 ml-auto">
    <%= form.submit class: "button" %>
  </div>
<% end %>
