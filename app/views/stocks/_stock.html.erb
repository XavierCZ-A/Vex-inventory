<div id="<%= dom_id stock %>" class="w-full sm:w-auto space-y-5">
      <tr class="bg-white hover:bg-gray-200">
        <td class="px-6 py-4">
          <p class="text-sm font-medium text-gray-900">
            <%= stock.product.name %>
          </p>
        </td>
        <td class="px-6 py-4">
          <span class="<%= category_color(stock.product.category.name) %> px-2 py-1 rounded-full text-xs">
            <%= stock.product.category.name %>
          </span>
        </td>
        <td class="px-6 py-4">
          <p class="text-sm font-medium text-gray-900">
            <%= number_to_currency(stock.product.price) %>
          </p>
        </td>
        <td class="px-6 py-4">
          <div class="flex items-center">
                    <p class="text-sm font-medium text-gray-900">
                      <%= stock.quantity %>
                    </p>
          </div>
        </td>
      </tr>
</div>
