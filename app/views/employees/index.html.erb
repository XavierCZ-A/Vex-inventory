<% content_for :title, "Employee" %>
<div class="w-full mx-auto p-3">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Orders</h1>
    <% if @users.any? %>
      <%= render Ui::ButtonComponent.new(
        path: new_order_path,
        text: "Create order",
        icon: "plus",
        turbo_frame: "modal"
      ) %>
    <% end %>
  </div>
  <hr class="w-full border-[#E5E7EB] mt-3 mb-5" />
  <div id="orders" class="overflow-hidden p-2 rounded-lg border border-gray-200 shadow">
    <% if @users.any? %>
      <section class="relative overflow-x-auto">
        <table class="min-w-full bg-white">
          <thead>
            <tr class="border-b border-[#E5E7EB]">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Permissions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @users.each do |user| %>
              <%= render "employees/employee", user: user %>
            <% end %>
          </tbody>
        </table>
      </section>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(
        title: "There are no orders",
        description: "This provider has no orders added. Do you want to add one now?",
        icon: "clipboard-check",
        icon_button: "plus",
        path: new_order_path,
        text: "Create order"
      ) %>
    <% end %>
  </div>
</div>
