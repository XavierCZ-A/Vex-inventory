<div id="<%= %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
      <%= user.full_name %>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= user.email_address %>
      </p>
    </td>
    <td class="px-6 py-4">
      <%= user.role %>
    </td>
    <td class="px-6 py-4">
      <span class="<%= status_employee_color(user.is_activate) %> px-2 py-1 rounded-full text-xs">
        <%= user.is_activate ? "Active" : "Inactive" %>
      </span>
    </td>
    <td class="px-6 py-4">
      <div class="flex items-center gap-2">
        <%= link_to root_path, class: "button-secondary-icon " do %>
          <%= tabler_icon('shield', size: '15', class: "mr-1") %>
          <span>Permissions</span>
        <% end %>

        <% if user.is_activate %>
          <%= button_to desactivate_employee_path(user),
            method: :patch, 
            class: "button-secondary-icon" do %>
            <%= tabler_icon('user-x', size: '15', class: "mr-2") %>
              <span>Desactivar</span>
          <% end %>

          <% else %>
            <%= button_to activate_employee_path(user),
              method: :patch, 
              class: "button-secondary-icon" do %>
              <%= tabler_icon('user-check', size: '15', class: "mr-2") %>
                <span>Activar</span>
            <% end %>
        <% end %>
        
      </div>
    </td>
  </tr>
</div>
