<div id="<%= %>" class="w-full sm:w-auto space-y-5">
    <tr class="bg-white hover:bg-gray-200">
    <td class="px-6 py-4">
      <%= user.full_name %>
    </td>
    <td class="px-6 py-4">
      <p class="text-sm font-medium text-gray-900">
        <%= user.email_address %>
      </p>
    </td>
    <td class="px-6 py-4">
      <%= user.role %>
    </td>
    <td class="px-6 py-4">
      <div class="flex items-center gap-2">
        <%= link_to root_path, class: "button-secondary-icon " do %>
          <%= tabler_icon('shield', size: '15', class: "mr-1") %>
          <span>Permissions</span>
        <% end %>
        <%= link_to root_path, class: "button-secondary-icon " do %>
          <%= tabler_icon('lock', size: '15', class: "mr-1") %>
          <span>Desactivate</span>
        <% end %>
      </div>
    </td>
  </tr>
</div>
